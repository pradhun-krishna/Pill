<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pill</AssemblyName>
    <Product>Pill</Product>
    <AssemblyTitle>Pill</AssemblyTitle>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Pradhun Krishna</Company>
    <Authors>Pradhun Krishna</Authors>
    <Description>Pill — Minimal native Windows dynamic notch for media, lyrics, widgets, quick controls, clipboard, and live alerts.</Description>
    <Copyright>Copyright (c) 2026 Pradhun Krishna</Copyright>
    <RootNamespace>NotchWin</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
