<Window x:Class="NotchWin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pill Settings"
        Width="760"
        Height="530"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Apple iOS-style Toggle Switch -->
        <Style x:Key="IosSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#24FFFFFF">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="2,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Sidebar Navigation Button -->
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#96FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="#22FFFFFF"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#E6FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFFFF" Stroke="#33000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border Margin="14" CornerRadius="18" Background="#0D0E12" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#090A0D" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" CornerRadius="17,0,0,17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="66"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Draggable Brand Header with Official Custom Logo -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="26" CornerRadius="8" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,10,0" Padding="3">
                                <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pill" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14.5" FontWeight="SemiBold" Foreground="#F5FFFFFF"/>
                                <TextBlock Text="Windows Dynamic Notch" FontSize="10" Foreground="#66FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Vayli / macOS-Style Colorful Sidebar Navigation -->
                    <StackPanel Grid.Row="1" Margin="10,4">
                        <Button x:Name="NavAppearance" Style="{StaticResource SideNavBtn}" Margin="0,0,0,3" Click="Nav_Click" Tag="Appearance">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5.5" Background="#5E5CE6" Margin="0,0,9,0">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SideAppearanceIco" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavResting" Style="{StaticResource SideNavBtn}" Margin="0,0,0,3" Click="Nav_Click" Tag="Resting">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5.5" Background="#0A84FF" Margin="0,0,9,0">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SideRestingIco" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="Resting Face" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBehavior" Style="{StaticResource SideNavBtn}" Margin="0,0,0,3" Click="Nav_Click" Tag="Behavior">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5.5" Background="#FF453A" Margin="0,0,9,0">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SideBehaviorIco" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="Behavior &amp; HUDs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavShortcuts" Style="{StaticResource SideNavBtn}" Margin="0,0,0,3" Click="Nav_Click" Tag="Shortcuts">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5.5" Background="#30D158" Margin="0,0,9,0">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SideShortcutsIco" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="Shortcuts &amp; Apps" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSystem" Style="{StaticResource SideNavBtn}" Click="Nav_Click" Tag="System">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5.5" Background="#636366" Margin="0,0,9,0">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SideSystemIco" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                                <TextBlock Text="System" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Live Footprint Badge -->
                    <Border Grid.Row="2" Margin="12,0,12,14" Padding="10,8" CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#30D158" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamBadgeLbl" Text="RAM: -- MB" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#D8FFFFFF" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <TextBlock Text="Native Win32 · 0% idle CPU" FontSize="9.5" Foreground="#60FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable Header + Close Button -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Margin="24,0,16,0">
                    <TextBlock x:Name="PageTitleLbl" Text="Appearance" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#F5FFFFFF" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconBtn}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" Foreground="#A0FFFFFF"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,24,22">
                    <Grid>
                        <!-- ═══ PAGE 1: APPEARANCE ═══ -->
                        <StackPanel x:Name="PageAppearance">
                            <TextBlock Text="FORM FACTOR" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Attached Notch Card -->
                                <Button x:Name="CardShapeNotch" Grid.Column="0" Style="{StaticResource CardBtn}" Padding="14,12" Click="ShapeNotch_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="8" Background="#12FFFFFF" Margin="0,0,0,10" ClipToBounds="True">
                                            <Border Width="86" Height="16" CornerRadius="0,0,8,8" Background="#060608" BorderBrush="#38FFFFFF" BorderThickness="1,0,1,1" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Attached Notch" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock Text="Flush with top bezel &amp; concave ears" FontSize="10.5" Foreground="#72FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Floating Island Card -->
                                <Button x:Name="CardShapeIsland" Grid.Column="2" Style="{StaticResource CardBtn}" Padding="14,12" Click="ShapeIsland_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="8" Background="#12FFFFFF" Margin="0,0,0,10">
                                            <Border Width="86" Height="16" CornerRadius="8" Background="#060608" BorderBrush="#38FFFFFF" BorderThickness="1" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Floating Island" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock Text="Detached pill floating below screen edge" FontSize="10.5" Foreground="#72FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="MATERIAL &amp; THEME" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <!-- Featured Dynamic Theme: Album Sync -->
                            <Button x:Name="SwatchAlbumSync" Style="{StaticResource CardBtn}" Margin="0,0,0,10" Padding="13,11" Click="Theme_Click" Tag="AlbumSync">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Margin="0,0,11,0" BorderBrush="#66FFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#E04E7BFF" Offset="0"/>
                                                <GradientStop Color="#E0A44EF5" Offset="0.52"/>
                                                <GradientStop Color="#E0FF5C8D" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Album Sync" FontSize="12.5" FontWeight="SemiBold" Foreground="#F6FFFFFF"/>
                                        <TextBlock Text="Dynamically matches live music thumbnail colors for the pill &amp; player" FontSize="10.5" Foreground="#88FFFFFF" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="8" Background="#24FFFFFF" Padding="7,2.5" VerticalAlignment="Center">
                                        <TextBlock Text="ADAPTIVE" FontSize="9" FontWeight="Bold" Foreground="#F0FFFFFF"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,18">
                                <Button x:Name="SwatchLiquid" Style="{StaticResource CardBtn}" Margin="0,0,8,8" Padding="11,10" Click="Theme_Click" Tag="LiquidGlass">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" BorderBrush="#55FFFFFF" BorderThickness="1">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC2B3142" Offset="0"/><GradientStop Color="#E00F1118" Offset="1"/></LinearGradientBrush></Border.Background>
                                        </Border>
                                        <TextBlock Text="Liquid Glass" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchObsidian" Style="{StaticResource CardBtn}" Margin="0,0,8,8" Padding="11,10" Click="Theme_Click" Tag="Obsidian">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" Background="#070709" BorderBrush="#28FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="Obsidian" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchGraphite" Style="{StaticResource CardBtn}" Margin="0,0,0,8" Padding="11,10" Click="Theme_Click" Tag="Graphite">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" Background="#1D1E26" BorderBrush="#35FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="Graphite" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchMidnight" Style="{StaticResource CardBtn}" Margin="0,0,8,0" Padding="11,10" Click="Theme_Click" Tag="Midnight">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" Background="#0D1628" BorderBrush="#406EA8FF" BorderThickness="1"/>
                                        <TextBlock Text="Midnight" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchCandy" Style="{StaticResource CardBtn}" Margin="0,0,8,0" Padding="11,10" Click="Theme_Click" Tag="CandyRose">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" Background="#241524" BorderBrush="#45FF85C0" BorderThickness="1"/>
                                        <TextBlock Text="Velvet Rose" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwatchFrost" Style="{StaticResource CardBtn}" Padding="11,10" Click="Theme_Click" Tag="Frost">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="7" Margin="0,0,9,0" Background="#F0F2F7" BorderBrush="#30000000" BorderThickness="1"/>
                                        <TextBlock Text="Frost Light" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="GEOMETRY &amp; GLOW" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Corner Roundness" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock x:Name="RadiusValLbl" Text="26 px" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <Slider x:Name="RadiusSlider" Style="{StaticResource ModernSlider}" Width="190" Minimum="14" Maximum="34" HorizontalAlignment="Right" ValueChanged="RadiusSlider_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Island Top Margin" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock x:Name="MarginValLbl" Text="8 px (Floating Island mode)" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <Slider x:Name="MarginSlider" Style="{StaticResource ModernSlider}" Width="190" Minimum="4" Maximum="20" HorizontalAlignment="Right" ValueChanged="MarginSlider_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Notch Hairline Outline" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Crisp specular 1px border around the notch silhouette" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkNotchOutline" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Album Art Ambient Glow" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Softly tint the notch background with the active song's cover art" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAlbumGlow" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ PAGE 2: RESTING FACE ═══ -->
                        <StackPanel x:Name="PageResting" Visibility="Collapsed">
                            <TextBlock Text="WHAT THE CLOSED NOTCH SHOWS AT IDLE" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button x:Name="FaceClockWeather" Style="{StaticResource CardBtn}" Margin="0,0,8,8" Padding="14,12" Click="Face_Click" Tag="ClockWeather">
                                    <StackPanel>
                                        <TextBlock Text="Clock + Weather" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Time on the left, live temperature on the right" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FaceClockOnly" Style="{StaticResource CardBtn}" Margin="0,0,0,8" Padding="14,12" Click="Face_Click" Tag="ClockOnly">
                                    <StackPanel>
                                        <TextBlock Text="Minimal Clock" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Clean centered time, zero clutter" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FaceClockDate" Style="{StaticResource CardBtn}" Margin="0,0,8,8" Padding="14,12" Click="Face_Click" Tag="ClockDate">
                                    <StackPanel>
                                        <TextBlock Text="Clock + Date" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Time paired with day &amp; short date" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FaceSystemStats" Style="{StaticResource CardBtn}" Margin="0,0,0,8" Padding="14,12" Click="Face_Click" Tag="SystemStats">
                                    <StackPanel>
                                        <TextBlock Text="System Stats" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Live CPU &amp; RAM percentages at a glance" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FaceBattery" Style="{StaticResource CardBtn}" Margin="0,0,8,0" Padding="14,12" Click="Face_Click" Tag="Battery">
                                    <StackPanel>
                                        <TextBlock Text="Clock + Battery" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Always keep laptop battery charge visible" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FaceMinimal" Style="{StaticResource CardBtn}" Padding="14,12" Click="Face_Click" Tag="Minimal">
                                    <StackPanel>
                                        <TextBlock Text="Stealth Pill" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        <TextBlock Text="Blank obsidian bar until music or hover" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="INDICATORS" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Privacy Dots &amp; Call Timer" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                        <TextBlock Text="Orange dot + live timer for microphone, green dot for camera" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkPrivacyDots" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ═══ PAGE 3: BEHAVIOR & DISPLAY ═══ -->
                        <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                            <TextBlock Text="FULLSCREEN &amp; TABS" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Slim Line on Fullscreen &amp; Maximized" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Shrinks to a thin top-edge hairline so browser tabs stay unobstructed" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkSlim" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Game Strip in True Fullscreen" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Show a compact CPU &amp; RAM strip during fullscreen games or F11" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkGameStrip" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Volume &amp; Brightness HUD" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Show a live inline slider bar inside the notch on media or brightness keys" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkVolumeHud" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,0,0,8">
                                <TextBlock Text="LIVE NOTIFICATIONS (DYNAMIC PILLS)" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Right" Background="#1AFFFFFF" Padding="10,3.5" Click="TestNotification_Click">
                                    <TextBlock Text="Test Live Pill" FontSize="10" Foreground="#F0FFFFFF"/>
                                </Button>
                            </Grid>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Bluetooth, Charger &amp; USB Alerts" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Brief pill when Bluetooth audio/devices, power cable, or USB drives connect" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkDeviceHuds" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Caps Lock &amp; Num Lock Indicator" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Subtle ON/OFF pill whenever Caps Lock or Num Lock is toggled" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkLockKeyHuds" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Now Playing Track Peek" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Briefly reveal cover art &amp; title when a new song begins while collapsed" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkTrackChangeHud" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Clipboard Copy Alerts" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Show a brief Copied · Text / Link / Image pill when you copy" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkClipboardHud" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="HOVER &amp; MONITOR" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Hover Open Delay" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock x:Name="HoverDelayLbl" Text="60 ms (prevents accidental tab-switch opens)" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <Slider x:Name="HoverDelaySlider" Style="{StaticResource ModernSlider}" Width="190" Minimum="0" Maximum="250" HorizontalAlignment="Right" ValueChanged="HoverDelaySlider_Changed"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Active Display" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Choose which monitor hosts Pill" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <StackPanel x:Name="MonitorListStack" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ PAGE 4: SHORTCUTS & APPS ═══ -->
                        <StackPanel x:Name="PageShortcuts" Visibility="Collapsed">
                            <TextBlock Text="GLOBAL KEYBOARD SHORTCUTS" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Toggle Notch Open / Close" FontSize="12" Foreground="#E8FFFFFF" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="6" Background="#18FFFFFF" Padding="8,3">
                                            <TextBlock Text="Ctrl + Alt + N" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Global Microphone Mute (All Apps)" FontSize="12" Foreground="#E8FFFFFF" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="6" Background="#18FFFFFF" Padding="8,3">
                                            <TextBlock Text="Ctrl + Alt + M" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBlock Text="Quick Launch Pinned Apps (Slots 1–6)" FontSize="12" Foreground="#E8FFFFFF" VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Right" CornerRadius="6" Background="#18FFFFFF" Padding="8,3">
                                            <TextBlock Text="Ctrl + Alt + 1 … 6" FontSize="11" FontWeight="SemiBold" Foreground="#F0FFFFFF"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="2,0,0,8">
                                <TextBlock Text="PINNED QUICK-LAUNCH APPS" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Right" Background="#18FFFFFF" Padding="10,4" Click="AddApp_Click">
                                    <TextBlock Text="+ Add Application" FontSize="10.5" Foreground="#F2FFFFFF"/>
                                </Button>
                            </Grid>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="12">
                                <StackPanel x:Name="SettingsAppsList"/>
                            </Border>
                        </StackPanel>

                        <!-- ═══ PAGE 5: SYSTEM ═══ -->
                        <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                            <TextBlock Text="STARTUP &amp; APPLICATION" FontSize="10" FontWeight="Bold" Foreground="#62FFFFFF" Margin="2,0,0,8"/>
                            <Border CornerRadius="13" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Start with Windows" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Automatically launch Pill when you sign in" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartup" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSetting_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="#10FFFFFF" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Reset All Preferences" FontSize="12" FontWeight="Medium" Foreground="#E8FFFFFF"/>
                                            <TextBlock Text="Restore default Liquid Glass theme and behavior" FontSize="10.5" Foreground="#6AFFFFFF"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Right" Background="#18FFFFFF" Padding="12,6" Click="Reset_Click">
                                            <TextBlock Text="Reset Defaults" FontSize="11" Foreground="#F0FFFFFF"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PillBtn}" Background="#2AFF453A" HorizontalAlignment="Left" Padding="16,8" Click="QuitApp_Click">
                                <TextBlock Text="Quit Pill" FontSize="12" Foreground="#FF6961"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
