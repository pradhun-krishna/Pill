<Window x:Class="NotchWin.UI.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pill"
        Width="660"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Soft frosted card surface matching NotchPixel's translucent tiles -->
        <LinearGradientBrush x:Key="FrostFaceDark" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#16FFFFFF" Offset="0"/>
            <GradientStop Color="#0BFFFFFF" Offset="0.5"/>
            <GradientStop Color="#06FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FrostFaceLight" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#14000000" Offset="0"/>
            <GradientStop Color="#08000000" Offset="0.55"/>
            <GradientStop Color="#04000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FrostRimDark" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22FFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FrostRimLight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22000000" Offset="0"/>
            <GradientStop Color="#0C000000" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="RootCanvas" Background="Transparent">
        <!-- Crisp 1px outer contrast halo (zero GPU DropShadowEffect RAM overhead) -->
        <Path x:Name="ShellOuterHalo" IsHitTestVisible="False" Stroke="#50000000" StrokeThickness="2" Fill="Transparent"/>

        <!-- Unified vector shell (concave ears in Notch mode, smooth pill in Island mode) -->
        <Path x:Name="ShellFill" Fill="#09090C"
              MouseEnter="Shell_MouseEnter" MouseMove="Shell_MouseMove" MouseLeave="Shell_MouseLeave"/>

        <!-- Subtle album-art ambient glow inside Media view -->
        <Path x:Name="ShellGlow" IsHitTestVisible="False" Opacity="0"/>

        <!-- Liquid Glass top specular sheen -->
        <Path x:Name="ShellSheen" IsHitTestVisible="False" Opacity="0.5"/>

        <!-- Specular hairline rim -->
        <Path x:Name="ShellBorder" IsHitTestVisible="False" Stroke="#28FFFFFF" StrokeThickness="1" Fill="Transparent"/>

        <!-- Clipped interactive content surface -->
        <Grid x:Name="ContentHost" HorizontalAlignment="Left" VerticalAlignment="Top"
              MouseEnter="Shell_MouseEnter" MouseMove="Shell_MouseMove" MouseLeave="Shell_MouseLeave">

            <!-- 1. SLIM LINE LAYER (fullscreen / maximized apps -> tabs 100% clear) -->
            <Grid x:Name="SlimLayer" Visibility="Collapsed" IsHitTestVisible="False">
                <Border x:Name="SlimPill" Width="38" Height="2" CornerRadius="1" Background="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 1B. GAME STRIP LAYER (optional CPU / RAM strip in true fullscreen) -->
            <Grid x:Name="GameStripLayer" Visibility="Collapsed" IsHitTestVisible="False" Margin="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#30D158" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GameStripCpuLbl" Text="CPU 0%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#E6FFFFFF" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text=" · " FontSize="9.5" Foreground="#55FFFFFF"/>
                    <TextBlock x:Name="GameStripRamLbl" Text="RAM 0%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#E6FFFFFF" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Grid>

            <!-- 2. COLLAPSED DYNAMIC PILL LAYER (NotchPixel / Dynamic Island Craft) -->
            <Grid x:Name="CollapsedLayer" IsHitTestVisible="False">
                <!-- Subtle bottom hairline playback progress bar (visible only while music plays) -->
                <Border x:Name="CollapsedProgressTrack" Height="2" VerticalAlignment="Bottom" Background="#16FFFFFF" Margin="18,0,18,0" CornerRadius="1" Visibility="Collapsed">
                    <Border x:Name="CollapsedProgressFill" Width="0" Height="2" CornerRadius="1" Background="#E0FFFFFF" HorizontalAlignment="Left"/>
                </Border>

                <Grid x:Name="CollapsedMain" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Idle Clock (Two-tone iOS hierarchy) -->
                    <StackPanel x:Name="CollapsedLeftIdle" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                        <TextBlock x:Name="CollapsedClockLeft" Text="3:15" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#F6FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CollapsedClockMeridiem" Text="PM" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#88FFFFFF" Margin="3,1.5,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Focus Countdown Capsule -->
                    <Border x:Name="CollapsedLeftFocus" CornerRadius="10" Background="#24BF5AF2" BorderBrush="#36BF5AF2" BorderThickness="1" Padding="7,2.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#BF5AF2" Margin="0,0,5.5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CollapsedFocusLbl" Text="25:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#F5FFFFFF" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Media: 22x22 Glass-Bordered Cover Art + Song Title -->
                    <Grid x:Name="CollapsedLeftMedia" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CollapsedArtFrame" Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                            <Image x:Name="CollapsedArt" Stretch="UniformToFill">
                                <Image.Clip><RectangleGeometry RadiusX="5" RadiusY="5" Rect="0,0,20,20"/></Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock x:Name="CollapsedTrackLbl" Grid.Column="1" Text="Now Playing" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#F6FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>

                    <!-- Right Status Chips & 5-Bar Dynamic Island Visualizer -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 5-Bar Animated Audio Spectrum (when music plays) -->
                        <StackPanel x:Name="CollapsedMediaViz" Orientation="Horizontal" VerticalAlignment="Center" Height="13" Margin="2,0,2,0" Visibility="Collapsed">
                            <Border x:Name="EqBar1" Width="2.2" Height="13" CornerRadius="1.1" Background="#E0FFFFFF" Margin="0,0,2,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="EqScale1" ScaleY="0.38"/></Border.RenderTransform></Border>
                            <Border x:Name="EqBar2" Width="2.2" Height="13" CornerRadius="1.1" Background="#E0FFFFFF" Margin="0,0,2,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="EqScale2" ScaleY="0.72"/></Border.RenderTransform></Border>
                            <Border x:Name="EqBar3" Width="2.2" Height="13" CornerRadius="1.1" Background="#E0FFFFFF" Margin="0,0,2,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="EqScale3" ScaleY="0.95"/></Border.RenderTransform></Border>
                            <Border x:Name="EqBar4" Width="2.2" Height="13" CornerRadius="1.1" Background="#E0FFFFFF" Margin="0,0,2,0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="EqScale4" ScaleY="0.62"/></Border.RenderTransform></Border>
                            <Border x:Name="EqBar5" Width="2.2" Height="13" CornerRadius="1.1" Background="#E0FFFFFF" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="EqScale5" ScaleY="0.34"/></Border.RenderTransform></Border>
                        </StackPanel>

                        <!-- Frosted Weather Chip -->
                        <Border x:Name="CollapsedWeather" CornerRadius="9" Background="#15FFFFFF" Padding="7,2.5" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="11.5" Height="11.5" Margin="0,0,4,0" VerticalAlignment="Center"><Path x:Name="CollapsedWeatherIcon" Stroke="#F0FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <TextBlock x:Name="CollapsedWeatherLbl" Text="26°" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#F0FFFFFF" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>

                        <!-- Frosted Date / CPU-RAM Chip -->
                        <Border x:Name="CollapsedRightDetailWrap" CornerRadius="9" Background="#14FFFFFF" Padding="7,2.5" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CollapsedRightDetail" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#D8FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Right Clock (when Focus is active) -->
                        <TextBlock x:Name="CollapsedClockRight" Text="3:15 PM" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#D4FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Visibility="Collapsed"/>

                        <!-- Color-Tinted Battery Chip -->
                        <Border x:Name="CollapsedBatteryWrap" CornerRadius="9" Background="#16FFFFFF" Padding="6.5,2.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CollapsedBattery" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#D8FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Live Call Timer Pill (Mic Active) -->
                        <Border x:Name="CollapsedCallWrap" CornerRadius="9" Background="#28FF9F0A" Padding="6.5,2.5" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="MicDot" Width="5.5" Height="5.5" Fill="#FF9F0A" Margin="0,0,4.5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CollapsedCallTimer" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#FFAE34" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Mic Muted Micro-Badge -->
                        <Border x:Name="CollapsedMicMutedIcon" Width="20" Height="20" CornerRadius="10" Background="#2EFF453A" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Viewbox Width="10.5" Height="10.5"><Path x:Name="CollapsedMicMutedPath" Stroke="#FF5A52" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                        </Border>

                        <!-- Camera Privacy Dot -->
                        <Ellipse x:Name="CamDot" Width="6.5" Height="6.5" Fill="#30D158" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- Dynamic Island Live Notification / HUD Pill Overlay -->
                <Grid x:Name="ToastLayer" Margin="12,0,12,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tinted Circular Icon Badge OR Rounded Album Art Thumbnail -->
                    <Border x:Name="ToastIconBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#24FFFFFF" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Viewbox Width="12.5" Height="12.5"><Path x:Name="ToastIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                    </Border>
                    <Border x:Name="ToastThumbBorder" Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="#1CFFFFFF" Margin="0,0,9,0" VerticalAlignment="Center" ClipToBounds="True" Visibility="Collapsed">
                        <Image x:Name="ToastThumbImg" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Center: Rich Title+Subtitle OR Live Volume/Brightness Bar -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel x:Name="ToastTextStack" VerticalAlignment="Center">
                            <TextBlock x:Name="ToastText" Text="Connected" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#F6FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ToastSubText" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="9.5" Foreground="#9AFFFFFF" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border x:Name="ToastBarTrack" Height="5.5" CornerRadius="2.75" Background="#28FFFFFF" Visibility="Collapsed">
                            <Border x:Name="ToastBarFill" Width="60" Height="5.5" CornerRadius="2.75" Background="#F5FFFFFF" HorizontalAlignment="Left"/>
                        </Border>
                    </Grid>

                    <!-- Right: Crisp Value / Status Pill -->
                    <Border x:Name="ToastRightBadge" Grid.Column="2" CornerRadius="9" Background="Transparent" Padding="0" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastValueLbl" Text="" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10.5" FontWeight="SemiBold" Foreground="#D0FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. EXPANDED NOTCHPIXEL LAYER -->
            <Grid x:Name="ExpandedLayer" Margin="16,9,16,14" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale" ScaleX="0.968" ScaleY="0.968"/>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- NOTCHPIXEL ICONIC TOP ICON STRIP (brand logo left, monochrome icons center, palette right) -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <!-- Top-Left Custom App Logo Mark -->
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="15" Stretch="Uniform"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,2" Opacity="0.90" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Tab 1: Media -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,4,0" ToolTip="Now Playing" Click="TabMedia_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="15" Height="15"><Path x:Name="NavMediaIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <Border x:Name="NavMediaDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Tab 2: Quick Sites (Globe, exact NotchPixel Image 1!) -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,4,0" ToolTip="Quick Sites" Click="TabSites_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="14.5" Height="14.5"><Path x:Name="NavSitesIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <Border x:Name="NavSitesDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Hidden"/>
                            </StackPanel>
                        </Button>
                        <!-- Tab 3: Widgets (Calendar, Focus Ring, Weather, Sparklines / Clock & To-Do) -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,4,0" ToolTip="Widgets" Click="TabWidgets_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="14.5" Height="14.5"><Path x:Name="NavWidgetsIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <Border x:Name="NavWidgetsDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Hidden"/>
                            </StackPanel>
                        </Button>
                        <!-- Tab 3: Control Center -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,4,0" ToolTip="Control Center" Click="TabControls_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="15" Height="15"><Path x:Name="NavControlsIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <Border x:Name="NavControlsDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Hidden"/>
                            </StackPanel>
                        </Button>
                        <!-- Tab 4: Clipboard History -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,4,0" ToolTip="Clipboard History" Click="TabClip_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="14.5" Height="14.5"><Path x:Name="NavClipIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                <Border x:Name="NavClipDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Hidden"/>
                            </StackPanel>
                        </Button>
                        <!-- Tab 5: Quick App Launcher -->
                        <Button Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="0,0,6,0" ToolTip="App Launcher (Ctrl+Alt+1–6)" Click="TabApps_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="14.5" Height="14.5"><Path x:Name="NavAppsIco" Fill="#99FFFFFF"/></Viewbox>
                                <Border x:Name="NavAppsDot" Width="3.5" Height="3.5" CornerRadius="1" Background="#FFFFFFFF" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Hidden"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="TopDivider" Width="1" Height="13" Background="#24FFFFFF" Margin="2,0,8,4" VerticalAlignment="Center"/>

                        <!-- Pin Open -->
                        <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Width="26" Height="26" Margin="0,0,3,3" ToolTip="Pin Open" Click="PinBtn_Click">
                            <Viewbox Width="13" Height="13"><Path x:Name="PinIcon" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                        </Button>

                        <!-- Settings Window -->
                        <Button Style="{StaticResource IconBtn}" Width="26" Height="26" Margin="0,0,0,3" ToolTip="Settings" Click="OpenSettings_Click">
                            <Viewbox Width="14" Height="14"><Path x:Name="SettingsGearIco" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Far Top-Right Theme Palette Quick-Cycle (concentric inset!) -->
                    <Button x:Name="ThemeCycleBtn" Style="{StaticResource IconBtn}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,2"
                            Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" ToolTip="Cycle Theme" Click="ThemeCycle_Click">
                        <Viewbox Width="13" Height="13"><Path x:Name="ThemePaletteIco" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                    </Button>
                </Grid>

                <!-- VIEW HOST -->
                <Grid x:Name="ViewHost" Grid.Row="1">

                    <!-- ═══ VIEW 1: NOTCHPIXEL MEDIA PLAYER (EXACT REF SCREENSHOT 3 + WAVY SCRUB BAR!) ═══ -->
                    <Grid x:Name="MediaPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="92"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Art + Source Badge | Title & Artist | Large Transport Controls -->
                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 82x82 Rounded-18 Album Art + Bottom-Right Mini Source Badge -->
                            <Grid Grid.Column="0" Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="ArtFrame" Width="82" Height="82" CornerRadius="18" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    <Grid>
                                        <Viewbox x:Name="ArtPlaceholder" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"><Path x:Name="ArtPlaceholderPath" Stroke="#48FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        <Image x:Name="ExpandedArt" Stretch="UniformToFill">
                                            <Image.Clip><RectangleGeometry RadiusX="17" RadiusY="17" Rect="0,0,80,80"/></Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                                <!-- Cute mini source badge overlapping bottom-right of album art -->
                                <Border x:Name="SourceMiniBadge" Width="25" Height="25" CornerRadius="8" Background="#E05C88" BorderBrush="#0A0A0E" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Viewbox Width="11" Height="11"><Path x:Name="SourceMiniIcon" Stroke="#0A0A0E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Border>
                            </Grid>

                            <!-- Title + Artist + Lyrics Pill -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="MediaTitleLbl" Text="Nothing Playing" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17.5" FontWeight="SemiBold" Foreground="#F8FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtistLbl" Text="Play music from Spotify, YouTube, etc." FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13" Foreground="#A0FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,7"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LyricsToggleBtn" Style="{StaticResource PillBtn}" Padding="9,3" Background="#16FFFFFF" Margin="0,0,6,0" ToolTip="Synced Lyrics (LRCLIB)" Click="LyricsToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="10" Height="10" Margin="0,0,4,0"><Path x:Name="LyricsBtnIcon" Stroke="#D0FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                            <TextBlock x:Name="LyricsBtnLbl" Text="Lyrics" FontSize="10" Foreground="#D0FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="QuickMicBtn" Style="{StaticResource PillBtn}" Padding="8,3" Background="#14FFFFFF" ToolTip="Global Mic Mute (Ctrl+Alt+M)" Click="MicMute_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="10" Height="10" Margin="0,0,4,0"><Path x:Name="QuickMicIcon" Stroke="#C8FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                            <TextBlock x:Name="QuickMicLbl" Text="Mic" FontSize="10" Foreground="#C8FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Large Unclipped Right-Side Transport Controls (EXACT NotchPixel Screenshot 3!) -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconBtn}" Width="34" Height="34" Margin="0,0,4,0" Click="PrevBtn_Click">
                                    <Viewbox Width="17" Height="17"><Path x:Name="PrevIcon" Fill="#B8FFFFFF"/></Viewbox>
                                </Button>
                                <Button x:Name="PlayPauseBtn" Style="{StaticResource IconBtn}" Width="44" Height="44" Margin="0,0,4,0" Click="PlayPauseBtn_Click">
                                    <Viewbox Width="23" Height="23"><Path x:Name="PlayPauseIcon" Fill="#FFFFFFFF"/></Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Width="34" Height="34" Click="NextBtn_Click">
                                    <Viewbox Width="17" Height="17"><Path x:Name="NextIcon" Fill="#B8FFFFFF"/></Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: ICONIC WAVY SINE-WAVE PROGRESS BAR + VERTICAL PILL THUMB -->
                        <Grid x:Name="ScrubTrack" Grid.Row="1" Height="22" Background="Transparent" Cursor="Hand" Margin="0,2,0,0" MouseLeftButtonDown="ScrubTrack_MouseDown">
                            <!-- Remaining flat line -->
                            <Line x:Name="WaveRemLine" X1="0" Y1="11" X2="480" Y2="11" Stroke="#38FFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Played wavy sine path colored in album accent! -->
                            <Path x:Name="WavePlayedPath" Stroke="#E888A8" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            <!-- Crisp vertical rounded white pill thumb -->
                            <Border x:Name="WaveThumb" Width="3.5" Height="14" CornerRadius="1.75" Background="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: Elapsed | Inline Mini Volume Slider | Remaining -->
                        <Grid Grid.Row="2" VerticalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TimeElapsedLbl" Text="0:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#B8FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <!-- Center Inline Mini Volume Control (exact NotchPixel Screenshot 3!) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconBtn}" Width="22" Height="22" Margin="0,0,6,0" ToolTip="Mute Audio" Click="VolMute_Click">
                                    <Viewbox Width="13" Height="13"><Path x:Name="QuickVolIcon" Stroke="#C8FFFFFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                </Button>
                                <Grid x:Name="MiniVolTrack" Width="112" Height="14" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                      MouseLeftButtonDown="MiniVol_MouseDown" MouseMove="MiniVol_MouseMove" MouseLeftButtonUp="MiniVol_MouseUp">
                                    <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center">
                                        <Border x:Name="MiniVolFill" Width="70" Height="4" CornerRadius="2" Background="#F0FFFFFF" HorizontalAlignment="Left"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="TimeDurationLbl" Text="-0:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#B8FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 3: Collapsible LRCLIB Synced Lyrics Drawer -->
                        <Border x:Name="LyricsDrawer" Grid.Row="3" Margin="0,10,0,0" Height="70" CornerRadius="14" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="14,7" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="LyricPrevLbl" Text="" FontSize="10.5" Foreground="#48FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LyricCurrLbl" Text="Fetching synced lyrics…" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                                <TextBlock x:Name="LyricNextLbl" Text="" FontSize="10.5" Foreground="#66FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══ VIEW 2: NOTCHPIXEL 2x2 WIDGETS GRID (EXACT REF SCREENSHOT 4!) ═══ -->
                    <!-- ═══ VIEW 1B: QUICK SITES (EXACT NOTCHPIXEL GLOBE TAB!) ═══ -->
                    <Grid x:Name="SitesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 3x2 Tinted Quick-Site Cards + Dashed "+ Add a site" -->
                        <UniformGrid x:Name="SitesGrid" Grid.Row="0" Columns="3" Rows="2" Margin="-4,0,-4,0"/>

                        <!-- Inline Add-Site Bar (replaces bottom hint when adding) -->
                        <Grid Grid.Row="1" Margin="2,8,2,0">
                            <TextBlock x:Name="SitesHintLbl" Text="Add a site: any page, signed in, one click away · Right-click to remove" FontSize="10.5" Foreground="#7AFFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="SiteAddWrap" CornerRadius="10" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="8,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="SiteNameInput" Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="11" VerticalContentAlignment="Center"
                                                 PreviewMouseDown="SiteInput_PreviewMouseDown" LostFocus="SiteInput_LostFocus" KeyDown="SiteInput_KeyDown"/>
                                        <TextBlock x:Name="SiteNamePlaceholder" Text="Name (opt)" FontSize="10.5" Foreground="#66FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Border Grid.Column="1" Width="1" Background="#22FFFFFF" HorizontalAlignment="Center" Margin="0,2"/>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="SiteUrlInput" Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="11" VerticalContentAlignment="Center"
                                                 PreviewMouseDown="SiteInput_PreviewMouseDown" LostFocus="SiteInput_LostFocus" KeyDown="SiteInput_KeyDown"/>
                                        <TextBlock x:Name="SiteUrlPlaceholder" Text="https://example.com" FontSize="10.5" Foreground="#66FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Grid.Column="4" Style="{StaticResource PillBtn}" Background="#F0FFFFFF" Padding="10,3.5" Click="SiteSave_Click">
                                        <TextBlock Text="Add" FontSize="10" Foreground="#0E0E12"/>
                                    </Button>
                                    <Button Grid.Column="6" Style="{StaticResource PillBtn}" Background="#18FFFFFF" Padding="8,3.5" Click="SiteCancel_Click">
                                        <TextBlock Text="Cancel" FontSize="10" Foreground="#C8FFFFFF"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ═══ VIEW 2: NOTCHPIXEL WIDGETS BENTO (2 Pages via Centered Floating Switch!) ═══ -->
                    <Grid x:Name="WidgetsPanel" Visibility="Collapsed">
                        <!-- PAGE 1 (DEFAULT — EXACT IMAGE 3: Calendar Week Strip | Focus Ring +/- | Weather | Live CPU/RAM/Net Sparklines) -->
                        <Grid x:Name="WidgetsPageMain">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="9"/>
                                <RowDefinition Height="100"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top-Left: Big Date + 7-Day Calendar Week Strip -->
                            <Border x:Name="WidgetCalendarCard" Grid.Row="0" Grid.Column="0" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="13,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="CalBigDayLbl" Text="18" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" LineHeight="26" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#F8FFFFFF" Typography.NumeralAlignment="Tabular"/>
                                            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CalDowLbl" Text="WED" FontSize="10.5" FontWeight="Bold" Foreground="#F0FFFFFF"/>
                                                <TextBlock x:Name="CalMonthLbl" Text="NOV" FontSize="10" FontWeight="SemiBold" Foreground="#88FFFFFF"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="CalWeekLbl" Text="Week 47" FontSize="10.5" FontWeight="Medium" Foreground="#88FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    </Grid>
                                    <UniformGrid x:Name="CalWeekStrip" Grid.Row="1" Columns="7" Rows="1" Margin="0,5,0,0" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <!-- Top-Right: Focus Timer Ring + Play/Pause Circle + (- / +) Minute Adjusters -->
                            <Border x:Name="WidgetFocusRingCard" Grid.Row="0" Grid.Column="2" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="13,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 58x58 Circular Countdown Ring -->
                                    <Grid Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center">
                                        <Ellipse Stroke="#22FFFFFF" StrokeThickness="3.6"/>
                                        <Path x:Name="FocusRingArc" Stroke="#BF5AF2" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="MiniFocusTimeLbl" Text="25:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#F8FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- Title + Controls -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock x:Name="MiniFocusLabel" Text="Focus timer" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4FFFFFF"/>
                                            <Button Style="{StaticResource IconBtn}" Width="18" Height="18" HorizontalAlignment="Right" ToolTip="Reset Timer" Click="FocusReset_Click">
                                                <Viewbox Width="9.5" Height="9.5"><Path x:Name="FocusResetIcon" Stroke="#88FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="MiniFocusBtnLbl" Grid.Row="1" Text="25 + 5 min" FontSize="10.5" Foreground="#88FFFFFF" Margin="0,1,0,7"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button x:Name="MiniFocusBtn" Style="{StaticResource IconBtn}" Width="28" Height="28" Background="#F4FFFFFF" Margin="0,0,6,0" Click="FocusStartPause_Click" ToolTip="Start / Pause Focus">
                                                <Viewbox Width="11" Height="11"><Path x:Name="MiniFocusPlayIcon" Fill="#0E0E12"/></Viewbox>
                                            </Button>
                                            <Button x:Name="FocusMinusBtn" Style="{StaticResource IconBtn}" Width="26" Height="26" Background="#1CFFFFFF" Margin="0,0,4,0" Click="FocusMinus_Click" ToolTip="-5 min">
                                                <Viewbox Width="10" Height="10"><Path x:Name="FocusMinusIcon" Stroke="#E8FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Viewbox>
                                            </Button>
                                            <Button x:Name="FocusPlusBtn" Style="{StaticResource IconBtn}" Width="26" Height="26" Background="#1CFFFFFF" Click="FocusPlus_Click" ToolTip="+5 min">
                                                <Viewbox Width="10" Height="10"><Path x:Name="FocusPlusIcon" Stroke="#E8FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round"/></Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bottom-Left: Weather Card with Divider & H/L (Exact Image 3!) -->
                            <Border x:Name="WidgetWeatherCard" Grid.Row="2" Grid.Column="0" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="WeatherTempLbl" Text="--°" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" LineHeight="31" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#F8FFFFFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"><Path x:Name="WeatherCardIcon" Stroke="#F5FFFFFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                    </Grid>
                                    <Border x:Name="WeatherDivider" Grid.Row="1" Background="#18FFFFFF" Margin="0,0,0,0"/>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock x:Name="WeatherCondLbl" Text="Loading…" FontSize="11" Foreground="#C8FFFFFF" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="WeatherHiLoLbl" Text="" FontSize="10.5" Foreground="#96FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bottom-Right: Live CPU / RAM Sparklines + Battery + Network Throughput (Exact Image 3!) -->
                            <Border x:Name="WidgetSparkCard" Grid.Row="2" Grid.Column="2" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="13,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- CPU Sparkline -->
                                    <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SparkCpuLbl" Text="CPU" FontSize="10.5" FontWeight="SemiBold" Foreground="#90FFFFFF" VerticalAlignment="Center"/>
                                        <Canvas x:Name="CpuSparkCanvas" Grid.Column="1" Height="16" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <Path x:Name="CpuSparkPath" Stroke="#F4FFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse x:Name="CpuSparkDot" Width="4.5" Height="4.5" Fill="#F4FFFFFF" Visibility="Collapsed"/>
                                        </Canvas>
                                        <TextBlock x:Name="SparkCpuVal" Grid.Column="2" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="#F6FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- RAM Sparkline -->
                                    <Grid Grid.Row="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SparkRamLbl" Text="RAM" FontSize="10.5" FontWeight="SemiBold" Foreground="#90FFFFFF" VerticalAlignment="Center"/>
                                        <Canvas x:Name="RamSparkCanvas" Grid.Column="1" Height="16" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <Path x:Name="RamSparkPath" Stroke="#FF9F0A" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse x:Name="RamSparkDot" Width="4.5" Height="4.5" Fill="#FF9F0A" Visibility="Collapsed"/>
                                        </Canvas>
                                        <TextBlock x:Name="SparkRamVal" Grid.Column="2" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="#F6FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- BAT Bar -->
                                    <Grid Grid.Row="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SparkBatLbl" Text="BAT" FontSize="10.5" FontWeight="SemiBold" Foreground="#90FFFFFF" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="4.5" CornerRadius="2.25" Background="#20FFFFFF" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <Border x:Name="SparkBatFill" Width="60" Height="4.5" CornerRadius="2.25" Background="#30D158" HorizontalAlignment="Left"/>
                                        </Border>
                                        <TextBlock x:Name="SparkBatVal" Grid.Column="2" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- Network Throughput Footer -->
                                    <Grid Grid.Row="3" Margin="0,4,0,0">
                                        <TextBlock x:Name="NetDownLbl" Text="↓ 0 B/s" FontSize="10" Foreground="#88FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="NetUpLbl" Text="↑ 0 B/s" FontSize="10" Foreground="#88FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PAGE 2 (ALT — Clock + World Clock | To-Do Checklist | Vayli Circular System Rings) -->
                        <Grid x:Name="WidgetsPageAlt" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="9"/>
                                <RowDefinition Height="100"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top-Left: Big Clock + World Clock -->
                            <Border x:Name="WidgetClockCard" Grid.Row="0" Grid.Column="0" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="14,11">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock x:Name="WidgetTimeNum" Text="3:46" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="27" LineHeight="28" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#F8FFFFFF" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock x:Name="WidgetTimeMeridiem" Text="PM" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="#99FFFFFF" Margin="4,0,0,2" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WidgetDayLbl" Text="WED" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#C8FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="12" Height="12" Margin="0,0,5,0"><Path x:Name="WorldClockGlobe" Stroke="#99FFFFFF" StrokeThickness="1.8"/></Viewbox>
                                            <TextBlock x:Name="WorldClockCity" Text="London" FontSize="11.5" Foreground="#C8FFFFFF"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WorldClockTime" Text="10:16 AM" FontSize="11.5" FontWeight="Medium" Foreground="#C8FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Top-Right: To-Do Checklist -->
                            <Border x:Name="WidgetTodoCard" Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TodoTitleLbl" Text="To do" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12.5" FontWeight="SemiBold" Foreground="#E8FFFFFF"/>
                                            <TextBlock x:Name="TodoCountLbl" Text="0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="12.5" FontWeight="Bold" Foreground="#88FFFFFF" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="TodoAddToggleBtn" Style="{StaticResource IconBtn}" Width="22" Height="22" Background="#16FFFFFF" HorizontalAlignment="Right" ToolTip="Add task" Click="TodoAddToggle_Click">
                                            <Viewbox Width="10.5" Height="10.5"><Path x:Name="TodoPlusIcon" Stroke="#E8FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Button>
                                    </Grid>
                                    <Border x:Name="TodoInputWrap" Grid.Row="1" CornerRadius="8" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Height="28" Padding="8,0" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <TextBox x:Name="NoteInput" Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF" FontSize="11.5" VerticalContentAlignment="Center"
                                                     PreviewMouseDown="NoteInput_PreviewMouseDown" LostFocus="NoteInput_LostFocus" KeyDown="NoteInput_KeyDown"/>
                                            <TextBlock x:Name="NotePlaceholder" Text="Type task &amp; press Enter…" FontSize="11" Foreground="#70FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer x:Name="TodoListScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="NotesListStack"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Bottom-Left: Vayli Circular System Rings (CPU / RAM / BAT) -->
                            <Border x:Name="WidgetSystemCard" Grid.Row="2" Grid.Column="0" CornerRadius="16" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SystemHeaderLbl" Text="SYSTEM" FontSize="9" FontWeight="Bold" Foreground="#72FFFFFF" Margin="1,0,0,4"/>
                                    <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="44" Height="44">
                                                <Ellipse Stroke="#1EFFFFFF" StrokeThickness="3.2"/>
                                                <Path x:Name="CpuRingArc" Stroke="#F2FFFFFF" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <TextBlock x:Name="CpuRingLbl" Text="0%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#F6FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="CpuRingCap" Text="CPU" FontSize="8.5" FontWeight="SemiBold" Foreground="#78FFFFFF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="44" Height="44">
                                                <Ellipse Stroke="#1EFFFFFF" StrokeThickness="3.2"/>
                                                <Path x:Name="RamRingArc" Stroke="#F2FFFFFF" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <TextBlock x:Name="RamRingLbl" Text="0%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10.5" FontWeight="Bold" Foreground="#F6FFFFFF" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="RamRingCap" Text="RAM" FontSize="8.5" FontWeight="SemiBold" Foreground="#78FFFFFF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="44" Height="44">
                                                <Ellipse Stroke="#1EFFFFFF" StrokeThickness="3.2"/>
                                                <Path x:Name="BatRingArc" Stroke="#30D158" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <TextBlock x:Name="WidgetBatPctLbl" Text="100%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#30D158" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="BatRingCap" Text="BAT" FontSize="8.5" FontWeight="SemiBold" Foreground="#78FFFFFF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Centered Floating Circular Widget-Page Switcher (Exact NotchPixel Image 3!) -->
                        <Button x:Name="WidgetFlipBtn" Style="{StaticResource IconBtn}" Width="34" Height="34"
                                Background="#EB1B1C22" BorderBrush="#3AFFFFFF" BorderThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="Switch Widgets Page (Calendar &amp; Stats ↔ Clock &amp; To-Do)" Click="WidgetFlip_Click">
                            <Viewbox Width="14" Height="14"><Path x:Name="WidgetFlipIcon" Stroke="#F0FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                        </Button>
                    </Grid>

                    <!-- ═══ VIEW 3: NOTCHPIXEL CONTROL CENTER (EXACT REF SCREENSHOT 2!) ═══ -->
                    <Grid x:Name="ControlsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="158"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <!-- Top Area: 2 Tall Vertical Capsule Sliders + 3x2 Color-Coded Tile Grid -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TALL VERTICAL BRIGHTNESS CAPSULE (true iOS rounded-capsule clip!) -->
                            <Border x:Name="BrightSliderTrack" Grid.Column="0" CornerRadius="20" Background="#20FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="BrightSlider_MouseDown" MouseMove="BrightSlider_MouseMove" MouseLeftButtonUp="BrightSlider_MouseUp">
                                <Grid>
                                    <Grid.Clip><RectangleGeometry Rect="0,0,62,156" RadiusX="19" RadiusY="19"/></Grid.Clip>
                                    <Border x:Name="BrightSliderFill" VerticalAlignment="Bottom" Height="112" Background="#F0F0F2"/>
                                    <TextBlock x:Name="BrightPercentLbl" Text="75%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#141418" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" IsHitTestVisible="False">
                                        <Path x:Name="BrightSliderIcon" Stroke="#141418" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- TALL VERTICAL VOLUME CAPSULE (true iOS rounded-capsule clip!) -->
                            <Border x:Name="VolSliderTrack" Grid.Column="2" CornerRadius="20" Background="#20FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="VolSlider_MouseDown" MouseMove="VolSlider_MouseMove" MouseLeftButtonUp="VolSlider_MouseUp">
                                <Grid>
                                    <Grid.Clip><RectangleGeometry Rect="0,0,62,156" RadiusX="19" RadiusY="19"/></Grid.Clip>
                                    <Border x:Name="VolSliderFill" VerticalAlignment="Bottom" Height="96" Background="#F0F0F2"/>
                                    <TextBlock x:Name="VolPercentLbl" Text="65%" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#141418" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" IsHitTestVisible="False">
                                        <Path x:Name="VolSliderIcon" Stroke="#141418" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- 3x2 COLOR-CODED ICON-BADGE TOGGLE GRID (generous 75px tiles, zero clipped descenders!) -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0, Col 0: Wi-Fi -->
                                <Button x:Name="WifiToggleBtn" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBtn}" Padding="10,7" Click="WifiToggle_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="WifiBadge" Width="25" Height="25" CornerRadius="12.5" Background="#0A84FF" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="WifiIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="WifiTitleLbl" Text="Wi-Fi" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock x:Name="WifiStateLbl" Text="On" FontSize="10" Foreground="#96FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 0, Col 2: Bluetooth -->
                                <Button x:Name="BtToggleBtn" Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBtn}" Padding="10,7" Click="BtToggle_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="BtBadge" Width="25" Height="25" CornerRadius="12.5" Background="#0A84FF" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="BtIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="BtTitleLbl" Text="Bluetooth" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock x:Name="BtStateLbl" Text="On" FontSize="10" Foreground="#96FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 0, Col 4: Global Mic Mute -->
                                <Button x:Name="CtrlMicBtn" Grid.Row="0" Grid.Column="4" Style="{StaticResource CardBtn}" Padding="10,7" ToolTip="Ctrl+Alt+M" Click="MicMute_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="MicBadge" Width="25" Height="25" CornerRadius="12.5" Background="#22FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="CtrlMicIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="CtrlMicTitle" Text="Mic" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock x:Name="CtrlMicLbl" Text="Live" FontSize="10" Foreground="#96FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 2, Col 0: Focus Mode -->
                                <Button x:Name="CtrlFocusBtn" Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBtn}" Padding="10,7" Click="FocusStartPause_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="FocusBadge" Width="25" Height="25" CornerRadius="12.5" Background="#22FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="CtrlFocusIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="CtrlFocusTitle" Text="Focus" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock x:Name="CtrlFocusState" Text="Off" FontSize="10" Foreground="#96FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 2, Col 2: Audio Mute -->
                                <Button x:Name="CtrlMuteBtn" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBtn}" Padding="10,7" Click="VolMute_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="MuteBadge" Width="25" Height="25" CornerRadius="12.5" Background="#22FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="CtrlMuteIcon" Stroke="#FFFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="CtrlMuteTitle" Text="Mute" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
                                        <TextBlock x:Name="CtrlMuteState" Text="Sound on" FontSize="10" Foreground="#96FFFFFF"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 2, Col 4: Battery -->
                                <Border x:Name="CtrlBatCard" Grid.Row="2" Grid.Column="4" CornerRadius="14" Background="{StaticResource FrostFaceDark}" BorderBrush="{StaticResource FrostRimDark}" BorderThickness="1" Padding="10,7">
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="12.5" Background="#2230D158" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <Viewbox Width="12.5" Height="12.5"><Path x:Name="CtrlBatIcon" Stroke="#30D158" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        </Border>
                                        <TextBlock x:Name="CtrlBatPctLbl" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock x:Name="CtrlStatusLbl" Text="Plugged in" FontSize="10" Foreground="#96FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Bottom 3-Segment Power Mode Pill Bar (true stadium-pill geometry!) -->
                        <Border x:Name="PowerBarWrap" Grid.Row="2" CornerRadius="19" Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="3">
                            <UniformGrid Columns="3">
                                <Button x:Name="PwrBatteryBtn" Style="{StaticResource PowerPillBtn}" Click="PowerPlan_Click" Tag="Battery">
                                    <TextBlock x:Name="PwrBatteryLbl" Text="Battery" FontSize="11.5"/>
                                </Button>
                                <Button x:Name="PwrBalancedBtn" Style="{StaticResource PowerPillBtn}" Click="PowerPlan_Click" Tag="Balanced">
                                    <TextBlock x:Name="PwrBalancedLbl" Text="Balanced" FontSize="11.5"/>
                                </Button>
                                <Button x:Name="PwrPerfBtn" Style="{StaticResource PowerPillBtn}" Click="PowerPlan_Click" Tag="Performance">
                                    <TextBlock x:Name="PwrPerfLbl" Text="Performance" FontSize="11.5"/>
                                </Button>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- ═══ VIEW 4: CLIPBOARD HISTORY ═══ -->
                    <Grid x:Name="ClipPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ClipFilterAll" Style="{StaticResource PillBtn}" Padding="10,3.5" Margin="0,0,4,0" Click="ClipFilter_Click" Tag="All"><TextBlock x:Name="ClipFilterAllLbl" Text="All" FontSize="10.5"/></Button>
                                <Button x:Name="ClipFilterText" Style="{StaticResource PillBtn}" Padding="10,3.5" Margin="0,0,4,0" Click="ClipFilter_Click" Tag="Text"><TextBlock x:Name="ClipFilterTextLbl" Text="Text" FontSize="10.5"/></Button>
                                <Button x:Name="ClipFilterLinks" Style="{StaticResource PillBtn}" Padding="10,3.5" Margin="0,0,4,0" Click="ClipFilter_Click" Tag="Link"><TextBlock x:Name="ClipFilterLinksLbl" Text="Links" FontSize="10.5"/></Button>
                                <Button x:Name="ClipFilterImages" Style="{StaticResource PillBtn}" Padding="10,3.5" Click="ClipFilter_Click" Tag="Image"><TextBlock x:Name="ClipFilterImagesLbl" Text="Images" FontSize="10.5"/></Button>
                            </StackPanel>
                            <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Right" Padding="10,3.5" Background="#14FFFFFF" Click="ClipClear_Click">
                                <TextBlock x:Name="ClipClearLbl" Text="Clear" FontSize="10" Foreground="#A8FFFFFF"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ClipListStack"/>
                        </ScrollViewer>
                        <TextBlock x:Name="ClipEmptyLbl" Grid.Row="1" Text="Copy any text, link, or image — history appears here automatically" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ═══ VIEW 5: QUICK CAPTURE (Screenshot/Snip/Record) + 6-SLOT APP LAUNCHER (EXACT IMAGE 2!) ═══ -->
                    <Grid x:Name="AppsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Action Row: Screenshot | Snip | Record -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CaptureShotBtn" Grid.Column="0" Style="{StaticResource CardBtn}" Padding="10,0" ToolTip="Capture screen to Pictures\Screenshots &amp; Clipboard" Click="CaptureScreenshot_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Path x:Name="CaptureShotIcon" Stroke="#F0FFFFFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                    <TextBlock x:Name="CaptureShotLbl" Text="Screenshot" FontSize="12" FontWeight="SemiBold" Foreground="#F4FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CaptureSnipBtn" Grid.Column="2" Style="{StaticResource CardBtn}" Padding="10,0" ToolTip="Open Windows Snipping Tool" Click="CaptureSnip_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="14.5" Height="14.5" Margin="0,0,8,0"><Path x:Name="CaptureSnipIcon" Stroke="#F0FFFFFF" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                    <TextBlock x:Name="CaptureSnipLbl" Text="Snip" FontSize="12" FontWeight="SemiBold" Foreground="#F4FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CaptureRecBtn" Grid.Column="4" Style="{StaticResource CardBtn}" Padding="10,0" ToolTip="Start Windows Screen Recorder" Click="CaptureRecord_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#FF3B30" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CaptureRecLbl" Text="Record" FontSize="12" FontWeight="SemiBold" Foreground="#F4FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Bottom 6-Slot Quick Launch Grid (Pinned apps or Dashed "+ Add" slots) -->
                        <UniformGrid x:Name="AppsGrid" Grid.Row="2" Columns="6" Rows="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
